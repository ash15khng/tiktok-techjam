# Safe template only. Copy to .env for local use and never commit the real key.
# SOCLAAS_BASE_URL should include /v1; the client appends /responses.
SHOPPING_COPILOT_LLM_ENABLED=0
SHOPPING_COPILOT_LLM_MAX_CALLS=64
SHOPPING_COPILOT_LLM_MODEL=llama3.1:8b
SOCLAAS_BASE_URL=https://your-soclaas-gateway.example/v1
SOCLAAS_API_KEY=
